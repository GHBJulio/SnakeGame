<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="500.0" maxWidth="800.0" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SnakeGame.Controllers.MenuController">
   <children>
      <ImageView fitHeight="560.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../MenuBackground.jpg" />
         </image>
      </ImageView>
      <Button fx:id="playButton" layoutX="344.0" layoutY="158.0" mnemonicParsing="false" onAction="#goToGame" prefHeight="35.0" prefWidth="112.0" text="Play" />
      <Button fx:id="leaderBoardButton" layoutX="344.0" layoutY="220.0" mnemonicParsing="false" onAction="#goToLeaderboard" prefHeight="35.0" prefWidth="112.0" text="LeaderBoard" />
      <Button fx:id="exitButton" layoutX="344.0" layoutY="289.0" mnemonicParsing="false" onAction="#exitApplication" prefHeight="35.0" prefWidth="112.0" text="Exit">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
      <Label layoutX="289.0" layoutY="44.0" prefHeight="72.0" prefWidth="244.0" text="Snake Game" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="45.0" />
         </font>
      </Label>
      <Button fx:id="backgroundButton" layoutX="344.0" layoutY="220.0" mnemonicParsing="false" onAction="#randomBackground" prefHeight="35.0" prefWidth="112.0" text="New Background" visible="false" />
   </children>
</AnchorPane>
