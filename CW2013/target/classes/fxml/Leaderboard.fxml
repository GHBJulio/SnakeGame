<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="500.0" maxWidth="800.0" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SnakeGame.Controllers.LeaderboardController">
    <children>
        <!-- Background Image -->
        <ImageView fitHeight="500.0" fitWidth="800.0">
            <image>
                <Image url="@../ColourTheme.jpg" />
            </image>
        </ImageView>
         <VBox fx:id="leaderboardVBox" alignment="CENTER" spacing="10" />

        <!-- Content Container -->
        <VBox alignment="TOP_CENTER" prefHeight="298.0" prefWidth="556.0" spacing="5">
            <Label style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-padding: 10; -fx-text-fill: #FFFF00;" text="Leaderboard" />
         <ImageView fx:id="backButton" fitHeight="54.0" fitWidth="86.0" onMouseClicked="#goBack" pickOnBounds="true" preserveRatio="true" translateX="-365.0" translateY="-67.0">
            <image>
               <Image url="@../backButton.png" />
            </image>
         </ImageView>
            <!-- Dynamically add player labels here -->
        </VBox>
    </children>
</StackPane>
